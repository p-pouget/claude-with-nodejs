# Token genere en local avec `claude setup-token` (voir README.md).
# Valable 1 an, ne se rafraichit pas tout seul.
# Generation :
#   npm install -g @anthropic-ai/claude-code
#   claude setup-token
# (un lien s'ouvre dans le navigateur, se connecter avec le compte Claude
# Pro/Max, le token s'affiche dans le terminal, le coller ci-dessous)
CLAUDE_CODE_OAUTH_TOKEN=a-faire

# EMPREINTE (sha256) du secret partage, obligatoire. Ce n'est PAS le secret :
# le serveur n'a besoin que de verifier le token presente, jamais de le
# connaitre en clair. Une lecture de son environnement ne rend donc rien
# d'exploitable.
#
# Generer les deux valeurs d'un coup :
#   node -e "const c=require('crypto'),t=c.randomBytes(64).toString('hex');console.log('secret (a garder !) :',t);console.log('SERVICE_TOKEN_HASH  :',c.createHash('sha256').update(t).digest('hex'))"
#
# Le "secret" va dans n8n (header x-service-token) ET dans ton gestionnaire de
# mots de passe. Il n'est stocke nulle part ici : perdu = a regenerer.
# L'empreinte ci-dessous fait 64 caracteres hex ; si tu en colles 128, c'est
# que tu as mis le secret par erreur et le serveur refusera de demarrer.
SERVICE_TOKEN_HASH=change-moi

# Nom du reseau Docker externe (doit deja exister). Volontairement en
# variable d'environnement et non en dur dans docker-compose.yml, pour ne
# pas exposer le nom de l'infrastructure reelle dans le repo.
DOCKER_NETWORK=change-moi

# Duree max (ms) d'un appel claude avant SIGKILL. Optionnel, defaut 10 min.
CLAUDE_TIMEOUT_MS=600000

# Modele par defaut si l'appel /run n'en precise pas (ex. sonnet, opus, haiku).
# Le champ "model" du body /run reste prioritaire sur cette valeur.
# Laisser vide = aucun flag --model n'est passe, le CLI claude choisit lui-meme.
# Garder la ligne (meme vide) evite un warning docker compose au demarrage.
CLAUDE_DEFAULT_MODEL=

# Outils autorises par defaut si l'appel /run ne precise pas "allowedTools".
# Obligatoire : sans valeur, le serveur refuse de demarrer (pas de liste par
# defaut en dur dans le code).
# Rappel (voir CLAUDE.md) : cette liste ne sandbox pas reellement Bash une
# fois autorise, la vraie protection reste le container + le tmpfs.
CLAUDE_ALLOWED_TOOLS=Read,Edit,Bash,Grep,Glob
